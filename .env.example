# Retr0Vault cloud configuration (Phase C).
#
# Copy this file to `.env` in the repository root and fill in the values.
# `.env` is git-ignored: never commit it, paste it into a chat, or screenshot it.
# The web app never receives these values; only the API and its tools read them.

# --- Database: Supabase Postgres -------------------------------------------
# Supabase dashboard → your project → Connect → "Session pooler".
# Replace [YOUR-PASSWORD] with the database password you set for the project.
# If the password contains characters such as @ : / ? # [ ] % or spaces,
# percent-encode them (for example @ becomes %40).
DATABASE_URL=postgresql://postgres.PROJECTREF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- File storage: any S3-compatible bucket (Backblaze B2 today) -------------
# Backblaze → Buckets: the bucket's "Endpoint" (add https://) and its name.
S3_ENDPOINT=https://s3.REGION.backblazeb2.com
# The region is the part of the endpoint after "s3.", e.g. us-west-004.
S3_REGION=REGION
S3_BUCKET=your-bucket-name
# Backblaze → Application Keys → Add a New Application Key:
# restricted to this bucket, Read and Write. keyID and applicationKey.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
