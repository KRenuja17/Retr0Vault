{
  "name": "retr0vault",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first visual inspiration and design-vocabulary archive",
  "type": "module",
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "npm run dev --workspace @retr0vault/api",
    "build": "tsc -b packages/shared apps/api --pretty false",
    "typecheck": "tsc -p tsconfig.typecheck.json --pretty false",
    "test": "npm run test --workspace @retr0vault/api",
    "capture:install": "npm run capture:install --workspace @retr0vault/api",
    "db:migrate": "npm run db:migrate --workspace @retr0vault/api",
    "db:generate": "npm run db:generate --workspace @retr0vault/api",
    "seed": "npm run seed --workspace @retr0vault/api",
    "seed:clear": "npm run seed:clear --workspace @retr0vault/api",
    "analysis:export-pending": "npm run analysis:export-pending --workspace @retr0vault/api --",
    "analysis:import": "npm run analysis:import --workspace @retr0vault/api --"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
